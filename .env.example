# Copy this file to .env and fill in your real secrets locally.
# Do NOT commit your real .env file.

# Set the AI provider to use: 'gemini', 'openai', 'anthropic', or 'mock'
V01_AI_PROVIDER=gemini

# Your Gemini API key (keep this secret). Example: GEMINI_API_KEY=sk-...
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model to use. Keep this set to a Gemini model your API key can actually access.
# Gemini 3.1 Pro is exposed as a preview model.
GEMINI_MODEL=gemini-3.1-pro-preview

# Other optional overrides
V01_API_HOST=127.0.0.1
V01_API_PORT=4310
V01_SQLITE_PATH=./data/v01.db

# Provider keys are intentionally unused by the foundation.
# The adapters in packages/ai-orchestrator are placeholders for future wiring.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

