{
  "name": "v01",
  "version": "0.0.0",
  "private": true,
  "description": "AI-first autonomous IDE foundation.",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @v01/api",
    "dev:desktop": "npm run dev --workspace @v01/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
